--cpu Cortex-M3
"uart_recieve\main.o"
"uart_recieve\stm32f1xx_it.o"
"uart_recieve\stm32f1xx_hal_msp.o"
"uart_recieve\stm32f1xx_hal_gpio_ex.o"
"uart_recieve\stm32f1xx_hal_tim.o"
"uart_recieve\stm32f1xx_hal_tim_ex.o"
"uart_recieve\stm32f1xx_hal_uart.o"
"uart_recieve\stm32f1xx_hal.o"
"uart_recieve\stm32f1xx_hal_rcc.o"
"uart_recieve\stm32f1xx_hal_rcc_ex.o"
"uart_recieve\stm32f1xx_hal_gpio.o"
"uart_recieve\stm32f1xx_hal_dma.o"
"uart_recieve\stm32f1xx_hal_cortex.o"
"uart_recieve\stm32f1xx_hal_pwr.o"
"uart_recieve\stm32f1xx_hal_flash.o"
"uart_recieve\stm32f1xx_hal_flash_ex.o"
"uart_recieve\stm32f1xx_hal_exti.o"
"uart_recieve\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "uart_recieve\uart_recieve.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "uart_recieve.map" -o uart_recieve\uart_recieve.axf